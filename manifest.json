{
  "manifest_version": 3,
  "name": "Type Bucket",
  "version": "1.0.0",
  "description": "Save highlighted text with a right-click",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": ["browser-polyfill.js", "background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {},
  "web_accessible_resources": [
    {
      "resources": ["sidebar/sidebar.html", "sidebar/sidebar.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
